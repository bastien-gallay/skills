# redaction release automation.
#
# Usage: just release 0.2.0
#
# Bumps the version in .claude-plugin/plugin.json, commits, and creates an
# annotated tag <plugin>/vX.Y.Z (monorepo tags carry the plugin prefix).
# Prevents the "forgot to bump plugin.json on release" silent-freeze failure
# mode: plugin.json is the only place the version lives.

set shell := ["bash", "-uc"]

plugin := file_name(justfile_directory())

default:
    @just --list

# Release a new version: bump plugin.json, commit, tag.
release VERSION:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ ! "{{VERSION}}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
        echo "error: VERSION must be semver (X.Y.Z or X.Y.Z-prerelease), got '{{VERSION}}'" >&2
        exit 2
    fi

    if ! git diff-index --quiet HEAD --; then
        echo "error: working tree is dirty, commit or stash first" >&2
        exit 2
    fi

    tag="{{plugin}}/v{{VERSION}}"
    if git rev-parse "$tag" >/dev/null 2>&1; then
        echo "error: tag $tag already exists" >&2
        exit 2
    fi

    if ! grep -qE "^## v{{VERSION}}( |$)" CHANGELOG.md; then
        echo "error: CHANGELOG.md has no '## v{{VERSION}}' section — rename '## Unreleased' before releasing" >&2
        exit 2
    fi

    plugin=".claude-plugin/plugin.json"
    tmp="$(mktemp)"
    jq --arg v "{{VERSION}}" '.version = $v' "$plugin" > "$tmp" && mv "$tmp" "$plugin"

    just check-versions
    git add "$plugin"
    git commit -m "chore({{plugin}}): release v{{VERSION}}"
    git tag -a "$tag" -m "Release {{plugin}} v{{VERSION}}"

    echo "✓ Tagged $tag. Push with: git push && git push origin $tag"

# Check plugin.json carries a semver version and the monorepo marketplace
# lists this plugin by path, without a version of its own to drift.
check-versions:
    #!/usr/bin/env bash
    set -euo pipefail
    p=$(jq -r .version .claude-plugin/plugin.json)
    if [[ ! "$p" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
        echo "plugin.json version is not semver: $p" >&2
        exit 1
    fi
    if ! jq -e --arg s "./plugins/{{plugin}}" \
        '[.plugins[] | select(.source == $s and (has("version") | not))] | length == 1' \
        ../../.claude-plugin/marketplace.json >/dev/null; then
        echo "root marketplace.json must list ./plugins/{{plugin}} once, without a version" >&2
        exit 1
    fi
    echo "✓ {{plugin}} $p (plugin.json is the only version)"

# Build the skill bundle as a .skill file into dist/.
# A .skill file is a plain zip archive with a .skill extension,
# OS-registered to Claude Desktop for one-click install via
# double-click and also accepted by the claude.ai web uploader.
# Archive layout: redaction/SKILL.md at the root (no skills/ prefix).
package:
    #!/usr/bin/env bash
    set -euo pipefail

    version=$(jq -r .version .claude-plugin/plugin.json)
    if [[ -z "$version" || "$version" == "null" ]]; then
        echo "error: could not read version from plugin.json" >&2
        exit 1
    fi

    mkdir -p dist
    out="dist/redaction-v${version}.skill"
    rm -f "$out"

    (cd skills && zip -r "../$out" redaction \
        -x 'redaction/.*' 'redaction/**/.*')

    echo "✓ built $out"
    unzip -l "$out"
